{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "dev": {
      "cache": false,
      "dependsOn": ["^dev"]
    },
    "build": {
      "outputs": ["dist/**", ".next/**", "build/**"],
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["^test"]
    },
    "prisma:generate": {
      "outputs": [],
      "dependsOn": []
    },
    "db:migrate": {
      "outputs": [],
      "dependsOn": []
    },
    "db:seed": {
      "outputs": [],
      "dependsOn": []
    }
  }
}